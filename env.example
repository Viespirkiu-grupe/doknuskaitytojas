PORT=3000 # If not specified, defaults to 3000
API_KEY=your_api_key_here # Your API key for authentication
UNOSERVER_HOST=localhost # Use "unoserver" inside Docker (overridden automatically)
MAX_CONCURRENT=4 # Max simultaneous document extractions (default: 4)
PDF_MAX_PAGES=10000 # Abort PDFs claiming more pages than this (default: 10000)
